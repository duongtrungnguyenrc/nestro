<div class="service">
  <div class="service-header">
    <span>{{@key}}</span>
    <span class="service-count">{{this.length}} instance{{#if (notEquals this.length 1)}}s{{/if}}</span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Host</th>
        <th>Port</th>
        <th>Status</th>
        <th>Registered At</th>
        <th>Expires At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each this}}
        {{> service-row }}
      {{/each}}
    </tbody>
  </table>
</div>
